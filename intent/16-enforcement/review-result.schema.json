{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schickling.dev/schemas/axe.intent.review.v1.json",
  "title": "Intent CLI Semantic Review Result",
  "type": "object",
  "required": ["schema_version", "summary", "findings"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "axe.intent.review.v1"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule",
          "severity",
          "artifact",
          "owner",
          "evidence",
          "suggested_fix",
          "gate"
        ],
        "properties": {
          "rule": {
            "type": "string",
            "pattern": "^INTENT\\.REVIEW\\.[a-z0-9.-]+$"
          },
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "error"]
          },
          "gate": {
            "type": "string",
            "const": "review"
          },
          "artifact": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "suggested_fix": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
